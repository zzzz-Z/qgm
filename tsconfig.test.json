// AIRUNNER-BATCH24-5-TSCONFIG-TEST: 覆盖 test/ 下测试文件；独立配置避免与 src 的 rootDir 冲突
{
  /* AIRUNNER-TEST-TSC */
  "compilerOptions": {
    "target": "ES2022",
    // AIRUNNER-BATCH24-7-LIB-DOM: 测试 import client/ 代码，需 DOM lib（window / FileReader / RequestInit.cache）
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "strict": true,
    "noImplicitOverride": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  // [test-tsc-scope-v1] 测试文件实际位于 packages/*/tests/；原 include 指向已不存在的 test/，
  //   tsc 报 TS18003「No inputs were found」→ 该检查长期形同虚设，测试里的类型错误无人拦截
  // [CHANGE-IMPACT] 覆盖面从「无输入」变为 core + client 全部 node-test；首次可能暴露存量错误
  "include": [
    "packages/*/tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.cjs"
  ]
}

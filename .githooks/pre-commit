#!/usr/bin/env bash
# cjs 语法闸：提交前对所有 staged .cjs 跑 node --check
set -e
FILES=$(git diff --cached --name-only --diff-filter=ACM -- "*.cjs")
[ -z "$FILES" ] && exit 0
for f in $FILES; do
  if ! node --check "$f" 2>/tmp/air-check-err; then
    echo "✗ $f 语法错误："
    cat /tmp/air-check-err
    exit 1
  fi
done
echo "✓ cjs 语法检查通过"

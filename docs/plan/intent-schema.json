{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Airunner Intent Declaration",
  "description": "侦察轮 AI 结构化报备（PLAN 阶段2）。意图词只能从 loader 词表选；允许无匹配词。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "files",
    "taskIntent"
  ],
  "properties": {
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "type",
          "actions"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "enum": [
              "vue",
              "ts",
              "js",
              "cjs",
              "css",
              "json",
              "md",
              "sh",
              "other"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "改样式",
                "改逻辑",
                "修 bug",
                "加测试",
                "重构",
                "文档",
                "配置",
                "脚本",
                "状态",
                "接口"
              ]
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "taskIntent": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "改样式",
          "改逻辑",
          "修 bug",
          "加测试",
          "重构",
          "文档",
          "配置",
          "git",
          "脚本",
          "状态",
          "接口",
          "其他"
        ]
      }
    },
    "notes": {
      "type": "string"
    },
    "noMatch": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

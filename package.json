{
  "name": "@zcc/vite-plugin-ai-runner",
  "version": "0.1.0",
  "description": "Vite dev-only AI 辅助开发工作台：脚本沙盒执行 / diff 回滚 / prompt 组装",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
    "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').copyFileSync('src/interceptor.cjs','dist/interceptor.cjs')\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web:dev": "vite --config client/vite.config.ts",
    "web:build": "vite build --config client/vite.config.ts",
    "lint": "eslint . --fix",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test --experimental-strip-types client/*.node-test.ts src/*.test.cjs",
    "test:e2e": "playwright test --config client/playwright.config.ts",
    "run-all": "node bin/run-all.cjs",
    "recover": "node bin/recover.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "client",
    "skills",
    "bin",
    "README.md"
  ],
  "bin": {
    "air-ask": "./bin/ai-ask.cjs",
    "air-check": "./bin/check-status.cjs",
    "air-log": "./bin/log-signal.cjs",
    "air-recover": "./bin/recover.cjs",
    "air-run-all": "./bin/run-all.cjs"
  },
  "dependencies": {
    "@ast-grep/cli": "^0.28.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@floating-ui/vue": "^2.0.0",
    "codemirror": "^6.0.2",
    "diff": "^7.0.0",
    "gpt-tokenizer": "^3.0.0",
    "highlight.js": "^11.12.0",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.11.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}

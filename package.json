{
  "name": "@zcc/vite-plugin-ai-runner",
  "version": "0.1.0",
  "description": "Vite dev-only AI 辅助开发工作台：脚本沙盒执行 / diff 回滚 / prompt 组装",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "web",
    "skills",
    "bin",
    "README.md"
  ],
  "bin": {
    "air-ask": "./bin/ai-ask.cjs",
    "air-check": "./bin/check-status.cjs",
    "air-log": "./bin/log-signal.cjs",
    "air-recover": "./bin/recover.cjs",
    "air-run-all": "./bin/run-all.cjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "codemirror": "^6.0.2",
    "gpt-tokenizer": "^3.0.0",
    "highlight.js": "^11.12.0",
    "playwright": "^1.63.0",
    "reka-ui": "^2.5.0",
    "vue": "^3.5.42"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "typescript": "^5.6.0",
    "vite": "^8.2.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "lint": "eslint .",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "test:unit": "node --test web/*.node-test.ts",
    "test:e2e": "playwright test --config web/playwright.config.ts",
    "run-all": "node bin/run-all.cjs",
    "recover": "node bin/recover.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "vue-demi"
    ]
  }
}

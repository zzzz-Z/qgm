{
  "name": "@qgm/ai-runner-workspace",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "workspace root（不发布）；对外发布走 apps/vite-plugin 与 apps/standalone",
  "license": "MIT",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node scripts/dev-all.mjs",
    "dev:web": "vite --config packages/client/vite.config.ts",
    "dev:server": "node scripts/dev-server.mjs",
    "build": "pnpm build:tsc && node scripts/build-all.mjs",
    "build:web": "vite build --config packages/client/vite.config.ts && node scripts/sync-client-dist.mjs",
    "build:server": "vite build --config apps/standalone/vite.config.ts",
    "build:watch": "node scripts/build-all.mjs --watch",
    "build:tsc": "tsc -p tsconfig.json && node scripts/copy-runtime.cjs",
    "git:archive": "node scripts/git-archive.mjs",
    "git:archive:watch": "node scripts/git-archive.mjs --watch",
    "start": "node apps/standalone/bin/air-server.cjs",
    "docker:deploy": "node scripts/docker-deploy.mjs",
    "docker:up": "node scripts/docker-deploy.mjs --no-build",
    "docker:rebuild": "node scripts/docker-deploy.mjs --build",
    "docker:down": "node scripts/docker-deploy.mjs --down",
    "docker:logs": "node scripts/docker-deploy.mjs --logs",
    "docker:prune": "node scripts/docker-deploy.mjs --prune",
    "session:start": "node scripts/session-start.cjs",
    "handoff:gen": "node scripts/handoff-gen.cjs",
    "lessons:add": "node bin/lessons-add.cjs",
    "lessons:status": "node scripts/lessons-status.cjs",
    "signals": "node bin/log-signal.cjs",
    "clean:ai-runner": "node scripts/clean-ai-runner.mjs",
    "docs:verify": "node scripts/verify-docs-index.cjs",
    "anchors:verify": "node scripts/verify-anchors.cjs",
    "crossfile:verify": "node scripts/verify-crossfile.cjs",
    "board:m3": "node scripts/board-m3.cjs",
    "board:unclosed": "node scripts/board-unclosed.cjs",
    "board:hit": "node scripts/board-hit-rate.cjs",
    "board:pending": "node scripts/board-pending.cjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "tsc": "tsc -p tsconfig.json --noEmit",
    "tsc:client": "vue-tsc -p tsconfig.client.json --noEmit",
    "typecheck": "pnpm tsc && pnpm tsc:apps && pnpm tsc:client && pnpm test:tsc",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e": "playwright test --config packages/client/playwright.config.ts",
    "verify": "pnpm anchors:verify && pnpm docs:verify && pnpm crossfile:verify && pnpm typecheck && pnpm lint && pnpm test:unit",
    "check-regression": "node bin/check-regression.cjs check",
    "baseline": "node scripts/screenshot-baseline.cjs",
    "run-all": "node bin/run-all.cjs",
    "recover": "node bin/recover.cjs",
    "test:watch": "vitest --config vitest.config.ts",
    "test:tsc": "vue-tsc -p tsconfig.test.json --noEmit",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "dev:all": "node scripts/dev-all.mjs",
    "tsc:apps": "tsc -p tsconfig.apps.json",
    "verify:contracts": "node scripts/verify-contracts.cjs",
    "analyze:confidence": "node scripts/analyze-confidence.cjs",
    "analyze:trust": "node scripts/analyze-trust-evolution.cjs",
    "stop": "pkill -f 'apps/standalone/dist/_server/index.js' || true"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": false
    }
  },
  "dependencies": {
    "@antfu/eslint-config": "^9.5.1",
    "@ast-grep/cli": "^0.28.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/state": "^6.7.4",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@floating-ui/vue": "^2.0.0",
    "@hono/node-server": "^2.1.1",
    "chalk": "^4.0.0",
    "codemirror": "^6.0.2",
    "diff": "^7.0.0",
    "gpt-tokenizer": "^3.0.0",
    "highlight.js": "^11.12.0",
    "hono": "^4.13.8",
    "unocss": "^66.10.5",
    "vitest": "^5.0.1",
    "vue": "^3.5.42",
    "ws": "^8.21.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "cloakbrowser": "^0.1.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/diff": "^7.0.0",
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^7.1.0",
    "@types/pngjs": "^6.0.5",
    "@types/ws": "^8.18.1",
    "@unocss/eslint-plugin": "^66.10.5",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vitest/coverage-v8": "5.0.1",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "^15.0.0",
    "eslint": "^9.39.4",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-vue": "^10.11.0",
    "eslint-vue-setup-rules": "^1.2.0",
    "happy-dom": "^20.14.5",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "sass-embedded": "^1.104.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "unplugin-auto-import": "^21.1.0",
    "vite": "^8.2.2",
    "vite-plugin-compression2": "^2.5.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
